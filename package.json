{
  "name": "pdf2img",
  "private": true,
  "version": "2.0.0",
  "description": "A privacy-first browser PDF toolbox for converting, merging, and splitting PDF files.",
  "homepage": "https://shenzhepei.github.io/pdf2img/",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
