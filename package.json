    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "24.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "25.0.1",
    "sass": "1.83.0",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "3.2.7"
